{
  "name": "agent-prototype-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Prototype and explore AI agent product experiences",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "prototype-studio": "bin/studio.js"
  },
  "scripts": {
    "start": "node bin/studio.js",
    "observe": "node bin/observe.js",
    "observe:mcp": "node bin/observe-mcp.js",
    "tools:mcp": "node bin/tools-mcp.js",
    "test": "node --test \"test/unit/*.test.js\" \"test/integration/*.test.js\"",
    "test:e2e": "playwright test",
    "check:claude": "node scripts/check-claude-code.js",
    "check:loop": "node scripts/check-loop.js",
    "install:chromium": "playwright-core install --only-shell chromium"
  },
  "dependencies": {
    "esbuild": "0.28.2",
    "playwright-core": "1.63.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
