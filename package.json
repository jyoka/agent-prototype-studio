{
  "name": "agent-prototype-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Try and measure an AI agent prototype, whole setup included, on your machine before you build it.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "prototype-studio": "bin/studio.js"
  },
  "scripts": {
    "start": "node bin/studio.js",
    "observe": "node bin/observe.js",
    "observe:mcp": "node bin/observe-mcp.js",
    "tools:mcp": "node bin/tools-mcp.js",
    "evals": "node bin/evals.js",
    "evals:import": "node bin/evals-import.js",
    "test": "node --test \"test/unit/*.test.js\" \"test/integration/*.test.js\"",
    "test:e2e": "playwright test",
    "media": "playwright test --config scripts/media/media.config.js",
    "site": "node scripts/site.js",
    "materials:sources": "node scripts/material-sources.js",
    "check:claude": "node scripts/check-claude-code.js",
    "check:sim": "node scripts/check-sim.js",
    "check:loop": "node scripts/check-loop.js",
    "check:organize": "node scripts/check-organize.js",
    "install:chromium": "playwright-core install --only-shell chromium"
  },
  "dependencies": {
    "@radix-ui/colors": "3.0.0",
    "@radix-ui/themes": "3.3.0",
    "esbuild": "0.28.2",
    "lucide-react": "1.65.0",
    "playwright-core": "1.63.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
