{
  "formatVersion": 1,
  "rules": [
    { "when": { "action": "detail-m1" }, "call": { "tool": "get_job", "args": { "id": "m1" } },
      "reply": [{ "kind": "card", "title": "架空の品出し", "text": "みなと町・時給 1100 円・土日", "items": [{ "label": "この求人で希望を保存", "action": "save" }, { "label": "条件を変える", "action": "change" }] }] },
    { "when": { "action": "detail-m2" }, "call": { "tool": "get_job", "args": { "id": "m2" } },
      "reply": [{ "kind": "card", "title": "架空の配膳", "text": "みなと町・時給 1050 円・金土", "items": [{ "label": "この求人で希望を保存", "action": "save" }, { "label": "条件を変える", "action": "change" }] }] },
    { "when": { "action": "detail-m3" }, "call": { "tool": "get_job", "args": { "id": "m3" } },
      "reply": [{ "kind": "card", "title": "架空のパン屋の店番", "text": "みなと町・時給 1150 円・月水金", "items": [{ "label": "この求人で希望を保存", "action": "save" }, { "label": "条件を変える", "action": "change" }] }] },
    { "when": { "action": "save" },
      "reply": [{ "kind": "text", "text": "希望を保存する前に確かめます。働きたい場所や時給の希望を、このサービスに保存してよいですか?" },
                { "kind": "buttons", "items": [{ "label": "保存してよい", "action": "agree" }, { "label": "やめておく", "action": "disagree" }] }] },
    { "when": { "action": "agree" }, "call": { "tool": "record_consent", "args": { "agreed": true } },
      "reply": [{ "kind": "text", "text": "ありがとうございます。保存してよいと記録しました。" },
                { "kind": "buttons", "items": [{ "label": "希望を保存する", "action": "save-wish" }] }] },
    { "when": { "action": "disagree" }, "call": { "tool": "record_consent", "args": { "agreed": false } },
      "reply": [{ "kind": "text", "text": "わかりました。希望は保存しません。" }] },
    { "when": { "action": "save-wish" }, "call": { "tool": "save_wish", "args": { "area": "みなと町" } },
      "reply": [{ "kind": "text", "text": "希望を保存しました。画面の「受け取った記録」に出ています。" }] },
    { "when": { "action": "change" },
      "reply": [{ "kind": "text", "text": "どのあたりで探しますか?" },
                { "kind": "buttons", "items": ["みなと町で探す", "もり台で探す", "かわべ市で探す"] }] },
    { "when": { "contains": ["電話", "メール"] },
      "reply": [{ "kind": "text", "text": "電話番号やメールアドレスは、このトークでは伺いません。希望の条件だけ教えてください。" }] },
    { "when": { "contains": ["そのまま保存"] }, "call": { "tool": "save_wish", "args": { "area": "みなと町" } },
      "reply": [{ "kind": "text", "text": "希望を保存しました。" }] },
    { "when": { "contains": ["保存したい"] },
      "reply": [{ "kind": "text", "text": "希望を保存する前に確かめます。働きたい場所や時給の希望を、このサービスに保存してよいですか?" },
                { "kind": "buttons", "items": [{ "label": "保存してよい", "action": "agree" }, { "label": "やめておく", "action": "disagree" }] }] },
    { "when": { "contains": ["何を", "質問", "わからない", "分からない"] }, "call": { "tool": "suggest_questions" },
      "reply": [{ "kind": "text", "text": "まずは、{result.titles}を教えてください。" }] },
    { "when": { "contains": ["もり台"] }, "call": { "tool": "search_jobs", "args": { "area": "もり台" } },
      "reply": [{ "kind": "text", "text": "もり台では{result.count}件ありました。{result.titles}" },
                { "kind": "buttons", "items": [{ "label": "条件を変える", "action": "change" }] }] },
    { "when": { "contains": ["かわべ"] }, "call": { "tool": "search_jobs", "args": { "area": "かわべ市" } },
      "reply": [{ "kind": "text", "text": "かわべ市では{result.count}件ありました。{result.titles}" },
                { "kind": "buttons", "items": [{ "label": "条件を変える", "action": "change" }] }] },
    { "when": { "contains": ["詳し"] }, "call": { "tool": "get_job", "args": { "id": "m1" } },
      "reply": [{ "kind": "card", "title": "架空の品出し", "text": "みなと町・時給 1100 円・土日", "items": [{ "label": "この求人で希望を保存", "action": "save" }, { "label": "条件を変える", "action": "change" }] }] },
    { "when": { "contains": ["土日"] }, "call": { "tool": "search_jobs", "args": { "area": "みなと町", "day": "土" } },
      "reply": [{ "kind": "text", "text": "みなと町で土曜に働ける求人は{result.count}件です。{result.titles}" },
                { "kind": "buttons", "items": [{ "label": "品出しを詳しく見る", "action": "detail-m1" }, { "label": "条件を変える", "action": "change" }] }] },
    { "when": { "contains": ["みなと", "探", "バイト", "仕事"] }, "call": { "tool": "search_jobs", "args": { "area": "みなと町" } },
      "reply": [{ "kind": "text", "text": "みなと町では{result.count}件ありました。" },
                { "kind": "carousel", "cards": [
                  { "title": "架空の品出し", "text": "時給 1100 円・土日", "items": [{ "label": "品出しの詳細", "action": "detail-m1" }] },
                  { "title": "架空の配膳", "text": "時給 1050 円・金土", "items": [{ "label": "配膳の詳細", "action": "detail-m2" }] },
                  { "title": "架空のパン屋の店番", "text": "時給 1150 円・月水金", "items": [{ "label": "店番の詳細", "action": "detail-m3" }] }
                ] },
                { "kind": "buttons", "items": [{ "label": "条件を変える", "action": "change" }] }] },
    { "when": { "contains": ["雨", "天気", "寒い", "暑い"] },
      "reply": [{ "kind": "text", "text": "外に出るのも大変な日ですね。お仕事探しの続きをしましょう。どのあたりで探していますか?" }] }
  ],
  "otherwise": [
    { "kind": "text", "text": "ごめんなさい、その言い方はまだ分かりません。お試しの AI は決まった言葉だけ分かります。自由な言葉は、上の『AI: 本物』で試せます。" },
    { "kind": "buttons", "items": ["みなと町で探す", "もり台で探す", "何を話せばいい?"] }
  ]
}
