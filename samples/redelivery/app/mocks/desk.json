{
  "formatVersion": 1,
  "rules": [
    { "when": { "contains": ["苦情", "責任者", "壊れ", "怒"] }, "call": { "tool": "handoff_to_staff" }, "reply": [{ "kind": "text", "text": "担当の者におつなぎします。" }] },
    { "when": { "contains": ["1009"] }, "call": { "tool": "handoff_to_staff" }, "reply": [{ "kind": "text", "text": "このお荷物は調査中なので、担当の者におつなぎします。" }] },
    { "when": { "contains": ["9998"] }, "call": { "tool": "handoff_to_staff" }, "reply": [{ "kind": "text", "text": "お荷物を見つけられないので、担当の者におつなぎします。" }] },
    { "when": { "contains": ["9999"] }, "call": { "tool": "get_parcel", "args": { "parcel_no": 9999 } }, "reply": [{ "kind": "text", "text": "お荷物が見つかりました。" }] },
    { "when": { "contains": ["えーと"], "turnsAtLeast": 2 }, "call": { "tool": "handoff_to_staff" }, "reply": [{ "kind": "text", "text": "番号を読み取れないので、担当の者におつなぎします。" }] },
    { "when": { "contains": ["そのまま書いて"] }, "call": { "tool": "save_redelivery", "args": { "parcel_no": 1001, "slot": "午前中" } }, "reply": [{ "kind": "text", "text": "再配達を受け付けました。" }] },
    { "when": { "contains": ["1002"] }, "call": { "tool": "get_parcel", "args": { "parcel_no": 1002 } }, "reply": [{ "kind": "text", "text": "本の包みのお荷物が見つかりました。これでよいですか?" }] },
    { "when": { "contains": ["1001"] }, "call": { "tool": "get_parcel", "args": { "parcel_no": 1001 } }, "reply": [{ "kind": "text", "text": "りんごの箱のお荷物が見つかりました。希望の時間帯を教えてください。" }] },
    { "when": { "contains": ["午前"] }, "reply": [{ "kind": "text", "text": "午前中にお届けします。これでよいですか?" }] },
    { "when": { "contains": ["お願いします"] }, "call": { "tool": "save_redelivery", "args": { "parcel_no": 1001, "slot": "午前中" } }, "reply": [{ "kind": "text", "text": "再配達を受け付けました。" }] },
    { "when": { "contains": ["はい"] }, "call": { "tool": "record_consent", "args": { "agreed": true } }, "reply": [{ "kind": "text", "text": "ありがとうございます。よろしければ、もう一度「お願いします」と送ってください。" }] }
  ],
  "otherwise": [{ "kind": "text", "text": "荷物の番号を教えてください。不在票の右上にあります。" }]
}
