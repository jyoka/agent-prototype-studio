{
  "$description": "架空の会社「みなと町くらし案内」のトークン。テストの見本です",
  "color": {
    "$type": "color",
    "background": { "$value": { "colorSpace": "srgb", "components": [1, 0.96, 0.9], "hex": "#fff5e6" } },
    "text": { "$value": { "colorSpace": "srgb", "components": [0.1, 0.1, 0.3] } },
    "accent": {
      "$description": "押せる所",
      "$value": { "colorSpace": "srgb", "components": [0, 0.5, 0.25], "hex": "#008040" }
    },
    "brand": { "$value": "{color.accent}" },
    "error": { "$value": { "colorSpace": "srgb", "components": [0.7, 0, 0] } }
  },
  "font": {
    "$type": "fontFamily",
    "body": { "$value": ["Minato Gothic", "monospace"] }
  },
  "size": {
    "$type": "dimension",
    "gap": { "$value": { "value": 24, "unit": "px" } }
  },
  "heading": {
    "$type": "typography",
    "$value": {
      "fontFamily": "{font.body}",
      "fontSize": { "value": 32, "unit": "px" },
      "fontWeight": "bold",
      "letterSpacing": { "value": 0, "unit": "px" },
      "lineHeight": 1.2
    }
  },
  "elevation": {
    "$type": "shadow",
    "$value": {
      "color": "{color.text}",
      "offsetX": { "value": 0, "unit": "px" },
      "offsetY": { "value": 2, "unit": "px" },
      "blur": { "value": 8, "unit": "px" },
      "spread": { "value": 0, "unit": "px" }
    }
  }
}
